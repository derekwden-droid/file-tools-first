{
  "description": "Tells Claude at session start to use Read, Edit and Write for files, and blocks Bash or PowerShell commands that only read a file or that write file contents, naming the file tool to use instead.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/file-tools-first.mjs", "--block-reads=${user_config.block_reads}"], "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/file-tools-first.mjs", "--block-reads=${user_config.block_reads}"], "timeout": 10 }
        ]
      }
    ]
  }
}
